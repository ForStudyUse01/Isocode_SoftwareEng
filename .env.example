# Database: local SQLite file by default; a Turso/libSQL URL in production
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=

# Random string, 32+ chars. Signs session cookies.
SESSION_SECRET=

# Optional. Without it, buyer summaries and reply drafts use the built-in rule-based generator.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Public site origin, used for sitemap and opt-out links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
